" .ideavimrc is a configuration file for IdeaVim plugin. It uses
"   the same commands as the original .vimrc configuration.
" You can find a list of commands here: https://jb.gg/h38q75
" Find more examples here: https://jb.gg/share-ideavimrc


"" -- Suggested options --
" Show a few lines of context around the cursor. Note that this makes the
" text scroll if you mouse-click near the start or end of the window.
set scrolloff=5

" Do incremental searching.
set incsearch

" Don't use Ex mode, use Q for formatting.
map Q gq

" --- Enable IdeaVim plugins https://jb.gg/ideavim-plugins

" Highlight copied text
Plug 'machakann/vim-highlightedyank'
" Commentary plugin
Plug 'tpope/vim-commentary'


"" -- Map IDE actions to IdeaVim -- https://jb.gg/abva4t
"" Map \r to the Reformat Code action
"map \r <Action>(ReformatCode)

"" Map <leader>d to start debug
"map <leader>d <Action>(Debug)

"" Map \b to toggle the breakpoint on the current line
"map \b <Action>(ToggleLineBreakpoint)
""" Map leader to space ------------------------------------
let mapleader=" "

""" Plugins -----------------------------------
set surround

""" Plugin settings -----------------------------------

""" Common setting -----------------------------------
set showmode
set incsearch
set showcmd
set number relativenumber
set clipboard+=unnamed

""" Idea specific settings ------------------

""" Mappings -----------------
" Move lines up and down in visual mode
xnoremap J :m '>+1<CR>gv=gv
xnoremap K :m '<-2<CR>gv=gv

" Remap :w and :W to :wa (save all)
nnoremap :w :wa<CR>
nnoremap :W :wa<CR>

" Remap :Q to :q (quit)
nnoremap :Q :q<CR>

" Remap :e and :E to :e! (force edit)
nnoremap :e :e!<CR>
nnoremap :E :e!<CR>

" Map :f and :F to Prettier command
nnoremap :f :Prettier<CR>
nnoremap :F :Prettier<CR>

" Center scrolling and search results
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz
nnoremap n nzzzv
nnoremap N Nzzzv
nnoremap N Nzzzv

" Replace selected text without yanking it
xnoremap <leader>p "_dP
" Copy to clipboard and delete without yanking

nnoremap <leader>y "+y
xnoremap <leader>y "+y
nnoremap <leader>Y "+Y
nnoremap <leader>d "_d
xnoremap <leader>d "_d

" Replace word under cursor
nnoremap <leader>ig :%s/\<<C-r><C-w>\>/<C-r><C-w>/gI<Left><Left><Left><CR>

" window navigations
nnoremap <S-l> gt
nnoremap <S-h> gT

"---------------------------------------------
" Actions
" # Git version control
map <leader>ghr <Action>(Vcs.RollbackChangedLines)
map <leader>ghR <Action>(ChangesView.Revert)
map <leader>ghp <Action>(VcsShowCurrentChangeMarker)

" # Buffers
map <leader>bo <Action>(CloseAllEditorsButActive)
map <leader>bd <Action>(CloseContent)
map <leader>bP <Action>(closeAllEditors)

map <leader><space> <Action>(GotoFile)
map <leader>sS <Action>(GotoSymbol)
map <leader>/ <Action>(FindInPath)
map gr <Action>(ShowUsages)
map <leader>ca <Action>(ShowIntentionActions)
map <leader>co <Action>(OptimizeImports)
map <leader>cf <Action>(ReformatCode)
map <leader>cr <Action>(RenameElement)
map <C-o> <Action>(Back)
map <C-i> <Action>(Forward)
map <leader>gg <Action>(LazyGit.Open)
map gcc <Action>(CommentByLineComment)
" plugins: NGSwitcher
map <leader>nu <Action>(live.angular.actions.SwitchToComponent)
map <leader>no <Action>(live.angular.actions.SwitchToTemplate)
map <leader>ni <Action>(live.angular.actions.SwitchToStyle)


map % <Action>(EditorMatchBrace)


